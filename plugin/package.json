{
  "name": "dsh-blue-whale",
  "version": "0.1.0",
  "description": "蓝鲸鱼 desktop bridge: the native-desktop channel (tray, notifications, window control) for the DeepSeek Harness web GUI. Host half owns the /blue-whale WebSocket channel the desktop shell connects to; the client half provides the dshDesktop service and completion notifications.",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoxin-ops/deepseek-.git",
    "directory": "plugin"
  },
  "author": {
    "name": "xiaoxin-ops",
    "email": "1219068231@qq.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "pack": "node ../scripts/pack-plugin.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-locale": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
